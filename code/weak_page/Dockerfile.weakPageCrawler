FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir playwright \
    && playwright install chromium --with-deps

COPY weakPageCrawler.py /app/weakPageCrawler.py
COPY js/router.js /app/source/js/router.js
COPY backend/src/app.js /app/source/backend/src/app.js
COPY backend/routes /app/source/backend/routes

ENV WEAK_PAGE_SOURCE_ROOT=/app/source

ENTRYPOINT ["python", "/app/weakPageCrawler.py"]
