# ⚠️ LAB VULNERABLE — solo para uso local

NODE_ENV=development
PORT=3009

# "vulnerable" | "secure"
# "vulnerable" = aplica los flags de config/vulnerabilities.js
# "secure"     = fuerza todos los flags a false
SECURITY_MODE=vulnerable

# Clave que se usa cuando JWT_WEAK_SECRET está desactivado
JWT_SECRET=cambia_esto_por_una_clave_de_256_bits_en_hex_aaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Clave AES para BASE64_FAKE_ENCRYPTION desactivado (32 bytes hex = 64 chars)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef