FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Dependencias del agente
COPY recon/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Contrato compartido y lógica del recon
COPY contract_schemas.py .
COPY llm_factory.py .
COPY recon/main.py .

CMD ["python", "main.py"]