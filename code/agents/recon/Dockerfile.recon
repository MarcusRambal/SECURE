FROM python:3.11-slim

WORKDIR /app

# Copia los requerimientos desde el contexto ./agents
COPY recon/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia el código fuente del agente de reconocimiento
COPY recon/main.py .

# Ejecuta el worker de recon directamente
CMD ["python", "main.py"]