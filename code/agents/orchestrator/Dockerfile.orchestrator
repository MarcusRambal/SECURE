FROM python:3.12-slim

# Evita que Python escriba archivos .pyc en disco y fuerza la salida de logs en tiempo real
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Instalar dependencias del sistema mínimas necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt-get/lists/*

COPY orchestrator/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copiar todo el contenido de la carpeta orchestrator/ 
COPY orchestrator/ .

# Crear un usuario sin privilegios por seguridad y asignar permisos sobre /app
RUN adduser --disabled-password --gecos "" appuser && chown -R appuser:appuser /app
USER appuser

#  Inicia el servicio del orquestador (API FastAPI) escuchando en el puerto 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]