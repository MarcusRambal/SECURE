FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema requeridas por Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg curl && rm -rf /var/lib/apt/lists/*

# Copiar requirements (asumiendo 'context: .' en docker-compose.yml)
COPY validate/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Instalar navegadores de Playwright
RUN playwright install chromium
RUN playwright install-deps chromium

# Copiar el contrato compartido desde la raíz y el código del agente
COPY contract_schemas.py .
COPY validate/main.py .

EXPOSE 8002
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]