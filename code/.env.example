# Copia este archivo a .env y completa los secretos localmente.

MODEL_ORCHESTRATOR=qwen2.5:7b-instruct
MODEL_RECON=qwen2.5:7b-instruct
MODEL_VALIDATE=qwen2.5:7b-instruct
MODEL_REPORTER=qwen2.5:7b-instruct

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b-instruct
LLM_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=0

MAX_TOKENS_ORCHESTRATOR=500
MAX_TOKENS_RECON=2000
MAX_TOKENS_VALIDATE=2000
MAX_TOKENS_REPORTER=4000

RABBITMQ_HOST=rabbitmq-broker
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me
RABBITMQ_PASS=change-me
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq-broker:5672/

# Access Control Prober (laboratorio). Si defines los tokens, se usan tal cual.
# Si no, Validate autentica con estas credenciales contra ACCESS_CONTROL_LOGIN_PATH.
ACCESS_CONTROL_LOGIN_PATH=/rest/user/login
ACCESS_CONTROL_VICTIM_EMAIL=admin@juice-sh.op
ACCESS_CONTROL_VICTIM_PASSWORD=admin123
ACCESS_CONTROL_ATTACKER_EMAIL=jim@juice-sh.op
ACCESS_CONTROL_ATTACKER_PASSWORD=ncc-1701
ACCESS_CONTROL_VICTIM_ID=1
# ACCESS_CONTROL_VICTIM_TOKEN=
# ACCESS_CONTROL_ATTACKER_TOKEN=

# Completa solo si usas esos proveedores.
GEMINI_API_KEY=
GROQ_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=SECURE_Proyecto_Final
LOG_RPC_PAYLOADS=false