FROM secsi/ffuf:latest

USER root

# Instalar git (necesario para clonar SecLists) y herramientas básicas
RUN apk add --no-cache git bash

# Descargar SecLists y copiar las wordlists que usamos
RUN git clone --depth 1 https://github.com/danielmiessler/SecLists.git /tmp/seclists && \
    mkdir -p /wordlists && \
    cp /tmp/seclists/Discovery/Web-Content/common.txt                      /wordlists/ && \
    cp /tmp/seclists/Discovery/Web-Content/api/api-endpoints.txt           /wordlists/ && \
    cp /tmp/seclists/Discovery/Web-Content/raft-medium-directories.txt     /wordlists/ && \
    cp /tmp/seclists/Usernames/top-usernames-shortlist.txt                 /wordlists/users_small.txt && \
    printf '# backup files placeholder\n' > /wordlists/backup-files.txt && \
    rm -rf /tmp/seclists && \
    wc -l /wordlists/*.txt

WORKDIR /app

ENTRYPOINT ["ffuf"]